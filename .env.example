# Telegram Bot Token
# Получите у @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Database URL
# Для PostgreSQL: postgresql://user:password@host:port/database?pgbouncer=true
# Для SQLite: sqlite:///path/to/database.db
# IMPORTANT: Add ?pgbouncer=true for Neon.tech serverless (reduces CU usage)
DATABASE_URL=sqlite:///fissure_bot.db

# Webhook URL (для Render)
# Формат: https://your-service-name.onrender.com/webhook
WEBHOOK_URL=https://fissure-bot.onrender.com/webhook

# Render service name
RENDER_SERVICE_NAME=fissure-bot

# Render region
RENDER_REGION=oregon
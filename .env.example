# Пример файла окружения для Fissure Bot
# Скопируйте этот файл в .env и заполните своими значениями

# Токен Telegram бота (обязательно)
BOT_TOKEN=your_telegram_bot_token_here

# URL базы данных (обязательно)
# Для SQLite: sqlite:///fissure_bot.db
# Для PostgreSQL: postgresql://user:password@host:port/database
DATABASE_URL=sqlite:///fissure_bot.db

# URL Render (для вебхука, опционально)
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com

# Порт (для Render, опционально)
PORT=10000
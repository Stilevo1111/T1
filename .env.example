# Telegram Bot Token
# Получите у @BotFather в Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Database URL
# PostgreSQL (Neon): postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Используйте pooled hostname (-pooler), не ?pgbouncer=true — psycopg2 его не поддерживает
# SQLite: sqlite:///path/to/database.db
DATABASE_URL=sqlite:///fissure_bot.db

# Redis URL (for caching)
REDIS_URL=redis://localhost:6379

# Webhook URL (для Render)
# Формат: https://your-service-name.onrender.com/webhook
WEBHOOK_URL=https://fissure-bot.onrender.com/webhook

# Render service name
RENDER_SERVICE_NAME=fissure-bot

# Render region
RENDER_REGION=oregon

# Port (Render sets this automatically, but you can override)
PORT=10000

# Admin chat ID (for admin commands and notifications)
ADMIN_CHAT_ID=

# OpenAI API key (for AI features, optional)
OPENAI_API_KEY=

# Party command limits (optional)
# PARTY_MAX_ABOVE=4    # Max players with MMR above requester
# PARTY_MAX_BELOW=3    # Max players with MMR below requester (total 8 with requester)

# OBS widget: default Steam ID for /api/obs-last5 without query params
# OBS_WIDGET_STEAM_ID=7656119xxxxxxxxxx

# Prometheus metrics (set to true to enable, disabled by default for serverless)
# PROMETHEUS_ENABLED=false